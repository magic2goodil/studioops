{
  "schemaVersion": 1,
  "project": {
    "key": "studioops",
    "repository": "https://github.com/magic2goodil/studioops"
  },
  "aggregateCommand": "npm run check",
  "fullRegressionTriggers": [
    "shared or multi-component change",
    "identity authorization safety or privacy change",
    "schema migration workflow deployment or composition-root change",
    "ambiguous unclassified or out-of-scope path"
  ],
  "fullRegressionKeywords": [
    "identity",
    "authorization",
    "consent",
    "privacy",
    "entitlement",
    "safety",
    "schema",
    "migration",
    "event version",
    "workflow",
    "deployment",
    "public contract",
    "dependency",
    "composition root",
    "shared kernel"
  ],
  "releaseSensitivePaths": [
    "src/component-impact-map.js",
    "src/impact-planner.js",
    "docs/architecture/components.json",
    "package.json",
    "src/store.js",
    "src/state-database.js",
    "src/progress-report.js",
    "src/lifecycle-policy.js",
    "src/dispatcher.js",
    "src/execution-policy.js",
    "src/runner.js",
    "src/run-output-evidence.js",
    "src/workspace.js",
    "src/project-validation-sandbox.js",
    "src/qa-integration.js",
    "src/promotion.js",
    "src/candidate-manifest.js",
    "src/self-update.js",
    "src/self-update-lease.js",
    "src/runtime-install.js"
  ],
  "prohibitedDependencies": [
    { "from": "workflow-state", "to": "owner-console" },
    { "from": "workflow-state", "to": "worker-execution" },
    { "from": "scheduling-dispatch", "to": "owner-console" }
  ],
  "components": {
    "repository-composition": {
      "owner": "devops-runtime",
      "aliases": ["package scripts", "aggregate validation", "repository composition"],
      "capabilities": ["stable repository validation entry point"],
      "paths": ["package.json", "scripts/run-tests.js", "scripts/test-environment.js", "test/test-environment.test.js"],
      "workflows": ["validation composition"],
      "publicContracts": ["npm run check aggregate contract"],
      "tests": [
        { "command": "npm run check", "layer": "composition" }
      ],
      "reviewOwners": ["backend-reviewer", "lead-reviewer"],
      "fullRegressionPaths": ["package.json", "scripts/run-tests.js", "scripts/test-environment.js"],
      "policyAuthorities": ["aggregate validation composition"],
      "dependsOn": ["component-impact-planning"],
      "shared": true,
      "rollback": "Restore the previous package script while retaining repository-local component ownership."
    },
    "component-impact-planning": {
      "owner": "backend-architecture",
      "aliases": ["component map", "impact map", "context packet", "scoped worker planning"],
      "capabilities": ["repository-scoped architecture index", "impact-scoped validation"],
      "paths": [
        "src/component-impact-map.js",
        "src/impact-planner.js",
        "docs/architecture/components.json",
        "docs/architecture/*.components.json",
        "test/component-impact-map.test.js"
      ],
      "services": ["component map loader", "impact planner", "prompt context-packet adapter"],
      "publicContracts": ["repository-bound component manifest", "content-addressed context packet", "out-of-scope handoff rejection"],
      "workflows": ["dispatch planning", "builder handoff", "exact-SHA QA validation"],
      "tests": [
        { "command": "node --test test/component-impact-map.test.js", "layer": "unit-contract" }
      ],
      "reviewOwners": ["backend-reviewer", "lead-reviewer"],
      "fullRegressionPaths": ["src/component-impact-map.js", "src/impact-planner.js", "docs/architecture/components.json"],
      "policyAuthorities": ["component impact classification"],
      "dependsOn": [],
      "rollback": "Stop attaching context packets; retain in-repository manifests and use the full aggregate validation path."
    },
    "workflow-state": {
      "owner": "backend-workflow-state",
      "aliases": ["task state", "SQLite state", "lifecycle"],
      "paths": ["src/store.js", "src/state-database.js", "src/lifecycle-policy.js", "test/state-database.test.js", "test/delivery-policy-enforcement.test.js", "test/resilience.test.js"],
      "data": ["projects", "tasks", "runs", "reviews", "events", "candidates"],
      "publicContracts": ["fenced aggregate mutation", "canonical task lifecycle"],
      "tests": [{ "command": "node --test test/state-database.test.js", "layer": "persistence" }],
      "reviewOwners": ["backend-reviewer"],
      "fullRegressionPaths": ["src/store.js", "src/state-database.js", "src/lifecycle-policy.js"],
      "policyAuthorities": ["task lifecycle state"],
      "dependsOn": ["component-impact-planning"],
      "shared": true,
      "rollback": "Stop new workflow transitions while retaining additive task and run metadata for audit."
    },
    "scheduling-dispatch": {
      "owner": "backend-automation",
      "aliases": ["dispatcher", "supervisor", "admission", "work lanes"],
      "paths": ["src/dispatcher.js", "src/supervisor.js", "src/work-lanes.js", "src/execution-policy.js", "src/config.js", "src/mission-control-cli.js", "studioops.config.example.md", "docs/LOCAL_AUTOMATION.md", "test/dispatcher.test.js", "test/config.test.js"],
      "services": ["supervisor planner", "dispatcher admission"],
      "publicContracts": ["dispatch admission decision", "lane-safe immutable run snapshot"],
      "workflows": ["architecture builder reviewer and owner dispatch"],
      "tests": [{ "command": "node --test test/dispatcher.test.js", "layer": "unit-contract" }],
      "reviewOwners": ["backend-reviewer"],
      "fullRegressionPaths": ["src/dispatcher.js", "src/execution-policy.js"],
      "policyAuthorities": ["worker admission"],
      "dependsOn": ["workflow-state", "component-impact-planning"],
      "rollback": "Disable scoped admission and route all eligible work through the prior full-regression dispatcher path."
    },
    "worker-execution": {
      "owner": "devops-runtime",
      "aliases": ["runner", "workspace", "Codex worker", "validation"],
      "paths": ["src/runner.js", "src/run-output-evidence.js", "src/workspace.js", "src/project-validation-sandbox.js", "test/runner.test.js", "test/run-output-evidence.test.js", "test/local-workspace-handoff.test.js"],
      "services": ["worker runner", "isolated git worktree", "validation adapter"],
      "publicContracts": ["repository-confined worker launch", "atomic pre-provider failure-attempt claim", "bounded redacted validation evidence"],
      "workflows": ["builder execution", "review execution"],
      "deploySurfaces": ["local LaunchAgent runner"],
      "tests": [{ "command": "node --test test/runner.test.js", "layer": "adapter" }],
      "reviewOwners": ["backend-reviewer", "lead-reviewer"],
      "fullRegressionPaths": ["src/runner.js", "src/run-output-evidence.js", "src/workspace.js", "src/project-validation-sandbox.js"],
      "dependsOn": ["workflow-state", "scheduling-dispatch", "component-impact-planning"],
      "rollback": "Stop worker launches, retain isolated workspaces, and restore the prior runner release."
    },
    "failure-recovery": {
      "owner": "techops-reliability",
      "aliases": ["failure containment", "watchdog", "TechOps", "circuit"],
      "paths": ["src/failure-containment.js", "src/watchdog.js", "src/techops.js", "src/remediation-handoff.js", "test/failure-containment.test.js", "test/watchdog.test.js", "test/techops.test.js"],
      "services": ["watchdog", "bounded TechOps repair", "remediation handoff"],
      "publicContracts": ["bounded failure recovery", "durable remediation handoff"],
      "workflows": ["failure recovery", "stale branch remediation"],
      "tests": [{ "command": "node --test test/watchdog.test.js test/techops.test.js", "layer": "recovery" }],
      "reviewOwners": ["backend-reviewer", "lead-reviewer"],
      "policyAuthorities": ["failure recovery routing"],
      "dependsOn": ["workflow-state"],
      "rollback": "Disable automated repair and leave incidents blocked for explicit owner recovery."
    },
    "qa-release": {
      "owner": "release-management",
      "aliases": ["QA", "candidate", "promotion", "release"],
      "paths": ["src/qa-integration.js", "src/promotion.js", "src/candidate-manifest.js", "src/candidate-repository.js", "src/owner-qa-packet.js", "test/qa-integration.test.js", "test/promotion.test.js", "test/qa-review-discoverability.test.js"],
      "services": ["immutable QA candidate", "release promotion"],
      "publicContracts": ["exact-SHA QA evidence", "owner-gated release candidate", "bounded preview startup identity polling"],
      "workflows": ["QA integration", "owner approval", "production promotion"],
      "deploySurfaces": ["protected production branch"],
      "tests": [{ "command": "node --test test/qa-integration.test.js test/promotion.test.js", "layer": "integration-release" }],
      "reviewOwners": ["lead-reviewer"],
      "fullRegressionPaths": ["src/qa-integration.js", "src/promotion.js", "src/candidate-manifest.js", "src/candidate-repository.js"],
      "policyAuthorities": ["production promotion authority"],
      "dependsOn": ["workflow-state"],
      "shared": true,
      "rollback": "Stop promotion, preserve immutable candidates and approvals, and restore the previous release manager."
    },
    "runtime-self-update": {
      "owner": "devops-runtime",
      "aliases": ["self update", "runtime install", "immutable runtime", "LaunchAgent restart"],
      "capabilities": ["verified runtime publication", "bounded worker restart", "durable workflow claim-aware restart deferral"],
      "paths": ["src/self-update.js", "src/self-update-lease.js", "src/runtime-install.js", "test/self-update.test.js", "test/runtime-install.test.js", "test/identity-verification.test.js"],
      "services": ["self-update planner", "runtime installer", "maintenance lease"],
      "publicContracts": ["clean fast-forward source update", "verified immutable runtime provenance", "bounded active QA and promotion claim diagnostics"],
      "workflows": ["StudioOps self-update", "runtime-only repair"],
      "deploySurfaces": ["local immutable runtime", "managed LaunchAgents"],
      "tests": [{ "command": "node --test test/self-update.test.js test/runtime-install.test.js", "layer": "runtime-release" }],
      "reviewOwners": ["backend-reviewer", "lead-reviewer"],
      "fullRegressionPaths": ["src/self-update.js", "src/self-update-lease.js", "src/runtime-install.js"],
      "policyAuthorities": ["StudioOps runtime publication"],
      "dependsOn": ["workflow-state"],
      "shared": true,
      "rollback": "Stop self-update and keep the last verified immutable runtime active while source state is repaired."
    },
    "plugin-interface": {
      "owner": "developer-experience",
      "aliases": ["StudioOps plugin", "Codex plugin", "plugin intake"],
      "capabilities": ["structured Codex intake", "plugin packaging"],
      "paths": ["plugins/studioops", "scripts/package-studioops-plugin.js", "test/plugin-submission.test.js", "test/studioops-plugin-client.test.js"],
      "services": ["local StudioOps client", "plugin packager"],
      "publicContracts": ["file-backed shell-safe intake", "public plugin manifest"],
      "workflows": ["Codex-to-StudioOps intake", "plugin packaging"],
      "deploySurfaces": ["local Codex plugin cache"],
      "tests": [{ "command": "node --test test/plugin-submission.test.js test/studioops-plugin-client.test.js", "layer": "plugin-contract" }],
      "reviewOwners": ["backend-reviewer", "lead-reviewer"],
      "dependsOn": ["owner-console"],
      "rollback": "Retain the prior packaged plugin and use the loopback API or board for intake."
    },
    "owner-console": {
      "owner": "frontend-owner-experience",
      "aliases": ["board", "owner inbox", "notifications", "dashboard"],
      "paths": ["src/server.js", "src/progress-report.js", "src/owner-inbox.js", "src/notifier.js", "public/app.js", "public/index.html", "public/styles.css", "test/progress-report.test.js", "test/progress-observability-ui.test.js", "test/owner-inbox-ui.test.js", "test/notifier.test.js", "test/server-request-security.test.js"],
      "routes": ["loopback owner API", "mission-control board"],
      "ui": ["owner inbox", "task detail", "project status", "progress metrics", "containment diagnostics"],
      "services": ["local notifier"],
      "publicContracts": ["loopback owner read model", "bounded project progress report", "deduplicated local notification"],
      "tests": [{ "command": "node --test test/owner-inbox-ui.test.js test/notifier.test.js", "layer": "browser-notification" }],
      "reviewOwners": ["frontend-reviewer", "lead-reviewer"],
      "fullRegressionPaths": ["src/progress-report.js"],
      "dependsOn": ["workflow-state"],
      "rollback": "Hide the new owner view while retaining workflow state and notification audit records."
    }
  }
}
